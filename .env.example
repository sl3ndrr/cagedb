# .env.example
# Documentation only. The static frontend cannot read this file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Local initial-import process only. Never expose this value to public/, Git, logs, or chat.
SUPABASE_SECRET_KEY=YOUR_LOCAL_SECRET_KEY

# Temporary compatibility only for older local setups. Prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_LOCAL_SERVICE_ROLE_KEY
